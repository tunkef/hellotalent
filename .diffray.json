{
  "executor": "claude-cli",
  "executors": {
    "claude-cli": {
      "model": "sonnet"
    }
  },
  "concurrency": 2,
  "timeout": 120,
  "agents": {
    "security-scan": { "enabled": false },
    "performance-check": { "enabled": false },
    "general": { "enabled": false },
    "database": { "enabled": false },
    "bug-hunter": { "enabled": false },
    "i18n": { "enabled": false },
    "observability": { "enabled": false }
  },
  "excludePatterns": [
    "*.min.js",
    "*.min.css",
    "node_modules/**",
    "reviews/**",
    "tasks/**",
    "docs/SESSION-LOG.md",
    "docs/handoff.md",
    ".agents/**",
    ".claude/**"
  ]
}
